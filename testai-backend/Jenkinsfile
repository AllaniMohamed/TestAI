pipeline {
    agent any

    // ─── Paramètres configurables depuis Jenkins UI ───────────────────────
    parameters {
        string(
            name: 'PROJECT_ID',
            defaultValue: '',
            description: 'UUID du projet TestAI à exécuter'
        )
        string(
            name: 'USER_ID',
            defaultValue: '00000000-0000-0000-0000-000000000001',
            description: 'UUID de l\'utilisateur Jenkins (service account)'
        )
        string(
            name: 'SUCCESS_THRESHOLD',
            defaultValue: '70',
            description: 'Taux de succès minimum requis (%)'
        )
    }

    environment {
        // Appel direct au service (bypass gateway + auth Keycloak)
        EXECUTION_SERVICE = "http://testai-execution-service:8086"
        EXECUTION_CONTEXT = "ci_cd"
    }

    stages {

        // ─── 1. Vérification ─────────────────────────────────────────────
        stage('Health Check') {
            steps {
                script {
                    echo "🔍 Vérification de l'execution-service..."

                    def health = sh(
                        script: """
                            curl -s -o /dev/null -w '%{http_code}' \
                                ${EXECUTION_SERVICE}/actuator/health || echo '000'
                        """,
                        returnStdout: true
                    ).trim()

                    if (health != '200') {
                        error("❌ execution-service inaccessible (HTTP ${health})")
                    }
                    echo "✅ execution-service opérationnel"

                    if (!params.PROJECT_ID?.trim()) {
                        error("❌ PROJECT_ID est requis. Configurez le pipeline.")
                    }
                    echo "📋 Project ID : ${params.PROJECT_ID}"
                }
            }
        }

        // ─── 2. Lancement de l'exécution ─────────────────────────────────
        stage('Launch Execution') {
            steps {
                script {
                    echo "🚀 Lancement de l'exécution pour le projet ${params.PROJECT_ID}..."

                    def body = """
                    {
                        "projectId": "${params.PROJECT_ID}",
                        "executedBy": "${params.USER_ID}",
                        "executionContext": "${EXECUTION_CONTEXT}"
                    }
                    """

                    def response = sh(
                        script: """
                            curl -s -X POST \
                                -H 'Content-Type: application/json' \
                                -d '${body.replaceAll("\\s+", " ").trim()}' \
                                ${EXECUTION_SERVICE}/api/executions/execute-project
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Réponse serveur : ${response}"

                    // Extraire executionId
                    def executionId = sh(
                        script: """
                            echo '${response}' | python3 -c \
                            "import sys,json; print(json.load(sys.stdin).get('executionId',''))"
                        """,
                        returnStdout: true
                    ).trim()

                    if (!executionId) {
                        error("❌ executionId introuvable dans la réponse : ${response}")
                    }

                    env.EXECUTION_ID = executionId
                    echo "✅ Exécution démarrée - ID : ${executionId}"
                }
            }
        }

        // ─── 3. Attente de fin ───────────────────────────────────────────
        stage('Wait for Completion') {
            steps {
                script {
                    echo "⏳ Attente de la fin des tests..."

                    def maxRetries = 60   // 10 minutes max (60 × 10s)
                    def retries    = 0
                    def status     = "RUNNING"

                    while (status == "RUNNING" && retries < maxRetries) {
                        sleep(10)

                        def result = sh(
                            script: """
                                curl -s \
                                ${EXECUTION_SERVICE}/api/executions/${env.EXECUTION_ID}/status
                            """,
                            returnStdout: true
                        ).trim()

                        status = sh(
                            script: """
                                echo '${result}' | python3 -c \
                                "import sys,json; print(json.load(sys.stdin).get('status','RUNNING'))"
                            """,
                            returnStdout: true
                        ).trim()

                        retries++
                        echo "[${retries}/${maxRetries}] Statut : ${status}"
                    }

                    if (status == "RUNNING") {
                        error("⏰ Timeout — exécution toujours en cours après 10 minutes")
                    }

                    env.FINAL_STATUS = status
                    echo "🏁 Statut final : ${status}"
                }
            }
        }

        // ─── 4. Analyse des résultats ─────────────────────────────────────
        stage('Analyse Results') {
            steps {
                script {
                    def result = sh(
                        script: """
                            curl -s \
                            ${EXECUTION_SERVICE}/api/executions/${env.EXECUTION_ID}/status
                        """,
                        returnStdout: true
                    ).trim()

                    // Parser les métriques
                    def successRate = sh(
                        script: """
                            echo '${result}' | python3 -c \
                            "import sys,json; print(json.load(sys.stdin).get('successRate', 0))"
                        """,
                        returnStdout: true
                    ).trim().toFloat()

                    def passed = sh(
                        script: """
                            echo '${result}' | python3 -c \
                            "import sys,json; print(json.load(sys.stdin).get('testsPassed', 0))"
                        """,
                        returnStdout: true
                    ).trim()

                    def failed = sh(
                        script: """
                            echo '${result}' | python3 -c \
                            "import sys,json; print(json.load(sys.stdin).get('testsFailed', 0))"
                        """,
                        returnStdout: true
                    ).trim()

                    def total = sh(
                        script: """
                            echo '${result}' | python3 -c \
                            "import sys,json; print(json.load(sys.stdin).get('totalTests', 0))"
                        """,
                        returnStdout: true
                    ).trim()

                    def duration = sh(
                        script: """
                            echo '${result}' | python3 -c \
                            "import sys,json; d=json.load(sys.stdin); print(round(d.get('totalDurationMs',0)/1000,2))"
                        """,
                        returnStdout: true
                    ).trim()

                    env.SUCCESS_RATE = successRate.toString()

                    echo """
╔══════════════════════════════════════╗
║         RÉSULTATS TESTAI             ║
╠══════════════════════════════════════╣
║  Total     : ${total}
║  ✅ Passés  : ${passed}
║  ❌ Échoués : ${failed}
║  📊 Taux    : ${String.format('%.1f', successRate)}%
║  ⏱️ Durée   : ${duration}s
╚══════════════════════════════════════╝
                    """

                    // Appliquer le seuil de qualité
                    def threshold = params.SUCCESS_THRESHOLD.toFloat()
                    if (successRate < threshold) {
                        currentBuild.result = 'UNSTABLE'
                        echo "⚠️ Taux ${String.format('%.1f',successRate)}% < seuil ${threshold}% → build UNSTABLE"
                    } else {
                        echo "🎉 Qualité validée ! (${String.format('%.1f',successRate)}% ≥ ${threshold}%)"
                    }
                }
            }
        }
    }

    // ─── Post-actions ──────────────────────────────────────────────────────
    post {
        always {
            echo "🔗 Voir résultats : http://localhost:3000/service/${params.PROJECT_ID}"
            echo "🔗 Jenkins build  : ${BUILD_URL}"
        }
        success {
            echo "✅ Pipeline réussi — Taux : ${env.SUCCESS_RATE}%"
        }
        unstable {
            echo "⚠️ Pipeline instable — Taux insuffisant"
        }
        failure {
            echo "❌ Pipeline en échec"
        }
    }
}